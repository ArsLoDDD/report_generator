{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Шаблонізатор",
  "version": "0.2.0",
  "identifier": "ua.shablonizator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Шаблонізатор",
        "width": 1920,
        "height": 1080,
        "minWidth": 1100,
        "minHeight": 680,
        "maximized": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFNUYzRTU3RjZGQUIzOUUKUldTZXMvcjJWejVmZnM2eEdZaVkvV2gxNXFHTy9IY0hBSy9NTXJ0NVZtVG03ampNWk1RYlVYMWsK",
      "dangerousInsecureTransportProtocol": true,
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
